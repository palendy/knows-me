# Vercel 프로젝트 환경변수 (심사 직전에 채우고 1회 배포).
# 로컬 테스트는 `vercel dev` + `.env.local`(gitignore됨).

# ── LLM 게이트웨이 (OpenAI 호환) — 하나만 켜서 사용 ─────────
# 이 데모는 배포에서 "옵션 A) OpenAI gpt-4o-mini"로 검증됨.

# 옵션 A) OpenAI 직접 (검증됨·권장 — 한도/예약 이슈 없음)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-proj-...
LLM_MODEL=gpt-4o-mini          # tool-calling 지원 모델(gpt-4.1-mini 등도 가능)

# 옵션 B) Google Gemini (OpenAI 호환) — AI Studio 키(AIza…, aistudio.google.com/apikey)
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_API_KEY=AIza...
# LLM_MODEL=gemini-2.5-flash

# 옵션 C) OpenRouter (OPENROUTER_* 도 하위호환 인식)
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=sk-or-...
# LLM_MODEL=google/gemini-3.8-flash
#   ⚠️ 저한도($5) 키는 요청당 예약 스택으로 402(in_flight_budget) 가능 → 키 한도 상향 필요.

# 응답 토큰 상한(선택, 기본 1024)
# LLM_MAX_TOKENS=1024
# 라운드 사이 정산 지연 ms(선택, 기본 0) — 빠듯한 OpenRouter 키의 402 완화용
# LLM_ROUND_DELAY_MS=0

# ── 오너 (심사 직전 실제 터널 URL·토큰으로 세팅 후 재배포) ────
OWNER1_NAME=지빈
OWNER1_URL=https://xxxx.trycloudflare.com
OWNER1_TOKEN=<앱에서 발급한 컨슈머 토큰>

OWNER2_NAME=OOO
OWNER2_URL=https://yyyy.trycloudflare.com
OWNER2_TOKEN=<앱에서 발급한 컨슈머 토큰>

# 오너를 더 추가하려면 OWNER3_*, OWNER4_* ... (최대 6) 같은 규칙으로.
