# knows-me — 로컬 실행 환경변수 (실제 값은 .env 에, .env 는 gitignore 됨)

# 기본값. 로컬에 설치된 Claude Code를 그대로 쓴다 — API 키가 필요 없고
# llm-http 피처 없이도 동작한다. 대신 호출당 10초 남짓 걸린다.
LLM_PROVIDER=claude-cli
# 같은 15개 세션 A/B: opus-5 확정 사실 23건 / sonnet-5 7건 (걸러냄 5 vs 11),
# 소요는 8% 차이(353초 vs 325초). 호출마다 에이전트 세션이 뜨는 구조라 지연은
# 토큰 수보다 기동 비용이 지배한다 — 큰 모델의 대가가 생각보다 싸다.
CLAUDE_CLI_MODEL=claude-opus-5       # 균형은 claude-sonnet-5, 속도는 claude-haiku-4-5
# CLAUDE_CLI_BINARY=claude
# CLAUDE_CLI_TIMEOUT_SECS=180

# --- HTTP 백엔드 (데스크탑 앱 기본 빌드에 포함. 코어 example은 --features llm-http) ---
# 로컬 LM Studio (키 불필요). 모델 이름은 LM Studio 서버 탭에 보이는 식별자 그대로.
#   - 앱을 같은 PC에서 돌리면 http://localhost:1234/v1
#   - WSL 안에서 돌리고 LM Studio는 Windows에 있으면 http://<Windows IP>:1234/v1
#     (WSL에서 `ip route | grep default` 의 IP, 예: 172.18.144.1) + LM Studio 서버
#     설정에서 "Serve on Local Network" 켜기
# LLM_PROVIDER=openai
# OPENAI_BASE_URL=http://localhost:1234/v1
# OPENAI_MODEL=google/gemma-4-12b

# 로컬 Ollama (키 불필요)
# LLM_PROVIDER=openai
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_MODEL=llama3.1

# Anthropic 직접
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-5

# OpenAI 호환 게이트웨이(OpenRouter 등). base_url 은 /v1 유무 모두 허용.
# LLM_PROVIDER=openai
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# OPENAI_API_KEY=sk-or-v1-...
