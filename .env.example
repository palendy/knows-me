# knows-me — 로컬 실행 환경변수 (실제 값은 .env 에, .env 는 gitignore 됨)
#
# LLM 게이트웨이: llm-http 피처로 빌드할 때만 읽습니다.
#   cargo run --features llm-http   /   npx tauri dev -- --features llm-http

# OpenRouter (OpenAI 호환) 사용 예시
LLM_PROVIDER=openai
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=google/gemini-3.8-flash
OPENAI_API_KEY=sk-or-v1-...            # 본인 키로 교체

# Anthropic 직접 사용 시
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-5
